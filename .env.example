# Copy to .env and fill in. Never commit .env.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare dashboard > Workers AI. Token needs "Workers AI: Read" and "Workers AI: Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# WaveSpeed: https://wavespeed.ai (new accounts get $1 free credit)
WAVESPEED_API_KEY=

# OpenRouter: https://openrouter.ai/keys (one key for many text, image and video models)
OPENROUTER_API_KEY=

# Addis AI: https://platform.addisassistant.com (Amharic/Oromo/Tigrinya LLM, translation, TTS; billed in ETB)
ADDIS_API_KEY=
